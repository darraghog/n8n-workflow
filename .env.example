# Required for n8n (when using project compose)
N8N_BASIC_AUTH_PASSWORD=      # Admin UI password
N8N_ENCRYPTION_KEY=            # Generate: openssl rand -hex 32

# Optional: use Postgres instead of SQLite
N8N_DATABASE=postgres
POSTGRES_PASSWORD=             # Only if N8N_DATABASE=postgres

# Shakespeare Play workflow: SMTP for email delivery
# Create "Send Email" credentials in n8n for your SMTP server (Gmail, etc.)
# OLLAMA_BASE_URL is used in workflow - default http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
