# Required for n8n (when using project compose)
N8N_BASIC_AUTH_PASSWORD=      # Admin UI password
N8N_ENCRYPTION_KEY=            # Generate: openssl rand -hex 32

# Optional: use Postgres instead of SQLite
N8N_DATABASE=postgres
POSTGRES_PASSWORD=             # Only if N8N_DATABASE=postgres

# n8n API (import, webhook discovery, evals)
N8N_API_KEY=
# N8N_API_URL=                 # optional override, default derived from target
# N8N_BASE_URL=http://127.0.0.1:5678   # optional; use when local tls-proxy (:8444) is down

# SMTP credential already created in the target n8n instance (required)
N8N_SMTP_CREDENTIAL_ID=
N8N_SMTP_CREDENTIAL_NAME=

# Must also be present in the n8n container env (compose passes these through)
SMTP_FROM_EMAIL=               # From address used by Send Email
OPERATOR_EMAIL=                # Error Trigger notifies this inbox only
EMAIL_ALLOWLIST=               # comma-separated emails and/or @domain.com; empty denies all; * allows all (unsafe)
EVAL_WEBHOOK_TOKEN=            # required header X-Eval-Token for the no-email test webhook

# Ollama (workflow reads these via $env; smoke probes OLLAMA_HEALTH_URL or this host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags

# Optional deploy/smoke
# HTTPS_CERT_FILE=
# HTTPS_KEY_FILE=
# HTTPS_REQUIRE_CLIENT_CERT=0
# REQUIRE_WEBHOOK_SMOKE_PASS=  # default: 0 for dev, 1 for test/prod
# REQUIRE_OLLAMA_SMOKE_PASS=1
# EVAL_WEBHOOK_URL=
# PROD_TARGET=beeblebox
